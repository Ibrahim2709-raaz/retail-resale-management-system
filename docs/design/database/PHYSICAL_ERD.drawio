<mxfile host="app.diagrams.net"><diagram name="Physical ERD"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="<b>users</b><hr>user_id | BIGINT | PK, generated<br>role | VARCHAR(20) | NOT NULL, CHECK<br>name | VARCHAR(120) | NOT NULL<br>login | VARCHAR(160) | NOT NULL, UNIQUE<br>password_hash | VARCHAR(255) | NOT NULL<br>is_active | BOOLEAN | NOT NULL DEFAULT TRUE<br>created_at | TIMESTAMPTZ | NOT NULL DEFAULT now()<br>updated_at | TIMESTAMPTZ | NOT NULL DEFAULT now()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25" y="62" width="280" height="132" as="geometry"/></mxCell><mxCell id="n2" value="<b>brands</b><hr>brand_id | BIGINT | PK, generated<br>name | VARCHAR(120) | NOT NULL, UNIQUE<br>is_active | BOOLEAN | NOT NULL DEFAULT TRUE<br>created_at | TIMESTAMPTZ | NOT NULL DEFAULT now()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="74" width="246" height="113" as="geometry"/></mxCell><mxCell id="n3" value="<b>categories</b><hr>category_id | BIGINT | PK, generated<br>parent_category_id | BIGINT | FK NULL<br>name | VARCHAR(120) | NOT NULL<br>is_active | BOOLEAN | NOT NULL DEFAULT TRUE<br>created_at | TIMESTAMPTZ | NOT NULL DEFAULT now()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="620" y="74" width="263" height="128" as="geometry"/></mxCell><mxCell id="n4" value="<b>products</b><hr>product_id | BIGINT | PK, generated<br>brand_id | BIGINT | FK NOT NULL<br>category_id | BIGINT | FK NOT NULL<br>internal_sku | VARCHAR(64) | NOT NULL UNIQUE<br>brand_sku | VARCHAR(100) | NULL<br>barcode | VARCHAR(100) | NULL UNIQUE<br>name | VARCHAR(180) | NOT NULL<br>color | VARCHAR(80) | NOT NULL<br>material | VARCHAR(120) | NULL<br>style | VARCHAR(120) | NULL<br>season | VARCHAR(60) | NULL<br>notes | TEXT | NULL<br>is_active | BOOLEAN | NOT NULL DEFAULT TRUE<br>created_at | TIMESTAMPTZ | NOT NULL DEFAULT now()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="918" y="62" width="340" height="187" as="geometry"/></mxCell><mxCell id="n5" value="<b>product_images</b><hr>image_id | BIGINT | PK, generated<br>product_id | BIGINT | FK NOT NULL<br>image_path | TEXT | NOT NULL<br>is_primary | BOOLEAN | NOT NULL DEFAULT FALSE<br>sort_order | SMALLINT | NOT NULL DEFAULT 0" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1300" y="81" width="289" height="120" as="geometry"/></mxCell><mxCell id="n6" value="<b>purchase_sources</b><hr>source_id | BIGINT | PK, generated<br>name | VARCHAR(160) | NOT NULL<br>source_type | VARCHAR(30) | NOT NULL CHECK<br>notes | TEXT | NULL<br>is_active | BOOLEAN | NOT NULL DEFAULT TRUE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25" y="339" width="272" height="120" as="geometry"/></mxCell><mxCell id="n7" value="<b>purchases</b><hr>purchase_id | BIGINT | PK, generated<br>source_id | BIGINT | FK NOT NULL<br>recorded_by_user_id | BIGINT | FK NOT NULL<br>purchase_type | VARCHAR(20) | NOT NULL CHECK<br>purchase_date | DATE | NOT NULL<br>external_order_no | VARCHAR(120) | NULL<br>shipping_cost | NUMERIC(12,2) | NOT NULL DEFAULT 0<br>receipt_ref | TEXT | NULL<br>status | VARCHAR(30) | NOT NULL CHECK<br>created_at | TIMESTAMPTZ | NOT NULL DEFAULT now()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="331" y="335" width="323" height="179" as="geometry"/></mxCell><mxCell id="n8" value="<b>purchase_items</b><hr>purchase_item_id | BIGINT | PK, generated<br>purchase_id | BIGINT | FK NOT NULL<br>product_id | BIGINT | FK NOT NULL<br>quantity_purchased | INTEGER | NOT NULL CHECK &gt; 0<br>unit_purchase_price | NUMERIC(12,2) | NOT NULL CHECK &gt;= 0<br>allocated_extra_cost | NUMERIC(12,2) | NOT NULL DEFAULT 0<br>final_unit_cost | NUMERIC(12,2) | NOT NULL CHECK &gt;= 0" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="688" y="339" width="340" height="183" as="geometry"/></mxCell><mxCell id="n9" value="<b>inventory_items</b><hr>inventory_item_id | BIGINT | PK, generated<br>purchase_item_id | BIGINT | FK NOT NULL<br>product_id | BIGINT | FK NOT NULL<br>condition | VARCHAR(30) | NOT NULL CHECK<br>status | VARCHAR(30) | NOT NULL CHECK<br>quantity_received | INTEGER | NOT NULL CHECK &gt; 0<br>quantity_available | INTEGER | NOT NULL CHECK &gt;= 0<br>received_at | TIMESTAMPTZ | NOT NULL<br>updated_at | TIMESTAMPTZ | NOT NULL DEFAULT now()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1062" y="343" width="340" height="187" as="geometry"/></mxCell><mxCell id="n10" value="<b>customers</b><hr>customer_id | BIGINT | PK, generated<br>name | VARCHAR(140) | NOT NULL<br>phone | VARCHAR(40) | NOT NULL<br>whatsapp | VARCHAR(40) | NULL<br>address | TEXT | NULL<br>city | VARCHAR(120) | NULL<br>notes | TEXT | NULL<br>is_active | BOOLEAN | NOT NULL DEFAULT TRUE<br>created_at | TIMESTAMPTZ | NOT NULL DEFAULT now()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25" y="600" width="297" height="148" as="geometry"/></mxCell><mxCell id="n11" value="<b>reservations</b><hr>reservation_id | BIGINT | PK, generated<br>customer_id | BIGINT | FK NOT NULL<br>inventory_item_id | BIGINT | FK NOT NULL<br>created_by_user_id | BIGINT | FK NOT NULL<br>quantity | INTEGER | NOT NULL CHECK &gt; 0<br>status | VARCHAR(30) | NOT NULL CHECK<br>reserved_at | TIMESTAMPTZ | NOT NULL DEFAULT now()<br>expires_at | TIMESTAMPTZ | NOT NULL<br>released_at | TIMESTAMPTZ | NULL<br>notes | TEXT | NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="357" y="608" width="331" height="171" as="geometry"/></mxCell><mxCell id="n12" value="<b>sales</b><hr>sale_id | BIGINT | PK, generated<br>customer_id | BIGINT | FK NOT NULL<br>created_by_user_id | BIGINT | FK NOT NULL<br>sale_date | TIMESTAMPTZ | NOT NULL DEFAULT now()<br>status | VARCHAR(30) | NOT NULL CHECK<br>subtotal | NUMERIC(12,2) | NOT NULL CHECK &gt;= 0<br>discount_total | NUMERIC(12,2) | NOT NULL DEFAULT 0<br>grand_total | NUMERIC(12,2) | NOT NULL CHECK &gt;= 0<br>due_date | DATE | NULL<br>payment_status | VARCHAR(30) | NOT NULL CHECK<br>notes | TEXT | NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="722" y="604" width="340" height="191" as="geometry"/></mxCell><mxCell id="n13" value="<b>sale_items</b><hr>sale_item_id | BIGINT | PK, generated<br>sale_id | BIGINT | FK NOT NULL<br>inventory_item_id | BIGINT | FK NOT NULL<br>quantity | INTEGER | NOT NULL CHECK &gt; 0<br>unit_price | NUMERIC(12,2) | NOT NULL CHECK &gt;= 0<br>discount_amount | NUMERIC(12,2) | NOT NULL DEFAULT 0<br>final_unit_price | NUMERIC(12,2) | NOT NULL CHECK &gt;= 0<br>unit_cost_snapshot | NUMERIC(12,2) | NOT NULL CHECK &gt;= 0<br>below_cost_ack | BOOLEAN | NOT NULL DEFAULT FALSE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1105" y="604" width="348" height="183" as="geometry"/></mxCell><mxCell id="n14" value="<b>payments</b><hr>payment_id | BIGINT | PK, generated<br>sale_id | BIGINT | FK NOT NULL<br>customer_id | BIGINT | FK NOT NULL<br>recorded_by_user_id | BIGINT | FK NOT NULL<br>amount | NUMERIC(12,2) | NOT NULL CHECK &gt; 0<br>method | VARCHAR(30) | NOT NULL CHECK<br>payment_date | TIMESTAMPTZ | NOT NULL DEFAULT now()<br>reference_no | VARCHAR(120) | NULL<br>notes | TEXT | NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25" y="873" width="314" height="171" as="geometry"/></mxCell><mxCell id="n15" value="<b>deliveries</b><hr>delivery_id | BIGINT | PK, generated<br>sale_id | BIGINT | FK NOT NULL UNIQUE<br>created_by_user_id | BIGINT | FK NOT NULL<br>tracking_ref | VARCHAR(80) | NOT NULL UNIQUE<br>delivery_address | TEXT | NOT NULL<br>delivery_fee | NUMERIC(12,2) | NOT NULL DEFAULT 0<br>rider_name | VARCHAR(140) | NULL<br>status | VARCHAR(30) | NOT NULL CHECK<br>created_at | TIMESTAMPTZ | NOT NULL DEFAULT now()<br>delivered_at | TIMESTAMPTZ | NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="374" y="873" width="340" height="187" as="geometry"/></mxCell><mxCell id="n16" value="<b>returns</b><hr>return_id | BIGINT | PK, generated<br>sale_id | BIGINT | FK NOT NULL<br>processed_by_user_id | BIGINT | FK NOT NULL<br>return_date | TIMESTAMPTZ | NOT NULL DEFAULT now()<br>reason | TEXT | NOT NULL<br>status | VARCHAR(30) | NOT NULL CHECK<br>refund_amount | NUMERIC(12,2) | NOT NULL DEFAULT 0<br>refund_method | VARCHAR(30) | NULL CHECK<br>notes | TEXT | NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="756" y="873" width="323" height="171" as="geometry"/></mxCell><mxCell id="n17" value="<b>return_items</b><hr>return_item_id | BIGINT | PK, generated<br>return_id | BIGINT | FK NOT NULL<br>sale_item_id | BIGINT | FK NOT NULL<br>quantity | INTEGER | NOT NULL CHECK &gt; 0<br>condition | VARCHAR(30) | NOT NULL CHECK<br>restock_status | VARCHAR(30) | NOT NULL CHECK" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1113" y="873" width="323" heigh